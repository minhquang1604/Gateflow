# ad-hoc script or REPL session).
mlruns/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code — local session/permission state, not shared config
.claude/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Database
*.db
*.sqlite
*.sqlite3

# Docs site build output (mkdocs.yml, docs-site/) — the gh-pages deploy
# workflow builds this in CI; it is never committed to main.
site/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Alembic
alembic/versions/*.pyc

# Large case-study datasets. Downloaded, not committed — creditcard.csv is
# 144 MB, past GitHub's 100 MB per-file limit. See
# case_studies/fraud_detection/README.md for how to fetch it.
case_studies/*/data/creditcard.csv


# Paper draft and the IEEE template it is built from. Kept out of the
# repository deliberately: the review process may be double-blind, and a
# draft carrying the author's name in a public repo would compromise
# that. Also avoids committing the 670 KB IEEEtran manual.
paper/
IEEE_Conference_Template.zip
