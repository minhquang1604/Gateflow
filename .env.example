# Database configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mlops_framework

# Database pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# MLflow tracking server (optional — leave blank to use a local mlflow setup)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=mlops-framework
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# Airflow orchestrator (optional — leave blank to use LocalDockerOrchestrator)
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow

# FastAPI ServingBridge URL (used by the HTTP event publisher).
SERVING_BRIDGE_URL=http://localhost:8001

# Application settings
APP_NAME=mlops-framework
APP_VERSION=1.0.0

# Development settings
DEBUG=false

# Telegram admin-approval gate (drift/retrain demo — scripts/run_drift_recovery_demo.py)
# Create a bot via @BotFather to get a token, then message it once and call
# https://api.telegram.org/bot<token>/getUpdates to read your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_APPROVAL_TIMEOUT_SECONDS=3600

# Slack admin-approval gate (the second channel that asks a person).
# Needs a Slack app with Socket Mode ON (gives the xapp- token, scope
# connections:write), Interactivity ON (without it a button press is
# never delivered, even over Socket Mode), and bot scopes chat:write,
# users:read and users:read.email. Install the app, invite the bot to
# the channel, and use the channel *id* (C0...), not its name.
# Verify end to end with scripts/verify_slack_gate.py before wiring it
# into a workflow. Requires: pip install 'gateflow[slack]'
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_APPROVAL_CHANNEL=
SLACK_APPROVAL_TIMEOUT_SECONDS=3600

# Shared secret gating every write endpoint: /api/internal/* (the whole
# router — the Airflow DAG's own callbacks) and the write half of
# /api/schedules. Sent as the X-Console-Token header. See
# src/mlops_framework/api/security.py.
#
# The gate FAILS CLOSED: with this unset those endpoints answer 503, the
# Airflow DAG cannot report a run back, and the console's Scheduling page
# becomes read-only. That is deliberate — an unconfigured deployment
# refuses writes instead of accepting anonymous ones. Generate a real
# value for anything reachable beyond your own machine:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
CONSOLE_WRITE_TOKEN=dev-console-token
